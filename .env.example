# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client — NOT the publishable/anon key

# LINE Login channel (developers.line.biz > your channel > Basic settings) — used to verify ID tokens server-side
LINE_CHANNEL_ID=your-line-login-channel-id        # the numeric Channel ID, NOT the Channel secret

# LINE LIFF app (developers.line.biz > your channel > LIFF tab) — used by the browser
NEXT_PUBLIC_LIFF_ID=your-liff-id

# Optional — set to 1 to show the "โหมดทดสอบ" button on ผลการจับคู่ (lists every
# facebook_import row unfiltered, for eyeballing scraped data). Off by default;
# leave unset in real production. Still requires a real LINE login to view.
NEXT_PUBLIC_DEV_TOOLS=
